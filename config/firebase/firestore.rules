rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function schemaV1() {
      return request.resource.data.schemaVersion == 1;
    }

    function optionalTimestamp(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] is timestamp;
    }

    function optionalConsentTimestamp(field) {
      return !(field in request.resource.data.consent)
        || request.resource.data.consent[field] is timestamp;
    }

    function optionalString(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || request.resource.data[field] is string;
    }

    function optionalStrictString(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] is string;
    }

    function optionalNonNegativeNumber(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is number
          && request.resource.data[field] >= 0);
    }

    function optionalNonNegativeNullableNumber(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is number
          && request.resource.data[field] >= 0);
    }

    function validConsentMap() {
      return request.resource.data.consent is map
        && request.resource.data.consent.keys().hasOnly([
          'accepted',
          'version',
          'acceptedAt',
          'updatedAt',
        ])
        && request.resource.data.consent.accepted is bool
        && request.resource.data.consent.version is string
        && optionalConsentTimestamp('updatedAt')
        && (!(request.resource.data.consent.keys().hasAny(['acceptedAt']))
          || (request.resource.data.consent.accepted == true
            && request.resource.data.consent.acceptedAt is timestamp));
    }

    function validGeneratedReport() {
      return request.resource.data.report is map
        && request.resource.data.report.keys().hasOnly([
          'source',
          'text',
          'errorReason',
        ])
        && request.resource.data.report.source in ['codex', 'template']
        && request.resource.data.report.text is string
        && request.resource.data.report.text.size() > 0
        && request.resource.data.report.text.size() <= 3000
        && (!(request.resource.data.report.keys().hasAny(['errorReason']))
          || request.resource.data.report.errorReason is string);
    }

    function validUserDoc() {
      return schemaV1()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'authType',
          'consent',
          'createdAt',
          'updatedAt',
          'lastActiveAt',
        ])
        && request.resource.data.authType == 'google'
        && validConsentMap()
        && optionalTimestamp('createdAt')
        && optionalTimestamp('updatedAt')
        && optionalTimestamp('lastActiveAt');
    }

    function validProfileDoc() {
      return schemaV1()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'status',
          'basic',
          'health',
          'familyHistory',
          'completedSteps',
          'createdAt',
          'updatedAt',
        ])
        && (!(request.resource.data.keys().hasAny(['status']))
          || request.resource.data.status in ['draft', 'complete'])
        && request.resource.data.basic is map
        && request.resource.data.health is map
        && request.resource.data.familyHistory is list
        && (!(request.resource.data.keys().hasAny(['completedSteps']))
          || request.resource.data.completedSteps is list)
        && optionalTimestamp('createdAt')
        && optionalTimestamp('updatedAt');
    }

    function validInsuranceDoc(insuranceId) {
      return schemaV1()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'id',
          'company',
          'productName',
          'coverageType',
          'coverageAmount',
          'amountUnit',
          'monthlyPremium',
          'joinedAt',
          'source',
          'createdAt',
          'updatedAt',
        ])
        && insuranceId.size() <= 128
        && request.resource.data.id == insuranceId
        && request.resource.data.coverageType in [
          'actual_medical',
          'cancer_diagnosis',
          'cerebrovascular_diagnosis',
          'cardiac_diagnosis',
          'disease_hospitalization',
          'accident_hospitalization',
          'surgery',
          'income_interruption',
          'death',
          'liability',
          'other',
        ]
        && request.resource.data.amountUnit in [
          'presence',
          'krw',
          'krw_per_event',
          'krw_per_day',
          'krw_per_month',
        ]
        && optionalStrictString('company')
        && optionalStrictString('productName')
        && optionalNonNegativeNullableNumber('coverageAmount')
        && optionalNonNegativeNumber('monthlyPremium')
        && optionalString('joinedAt')
        && (!(request.resource.data.keys().hasAny(['source']))
          || request.resource.data.source == 'manual')
        && optionalTimestamp('createdAt')
        && optionalTimestamp('updatedAt');
    }

    function validReportDoc() {
      return schemaV1()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'summary',
          'report',
          'createdAt',
        ])
        && request.resource.data.summary is map
        && validGeneratedReport()
        && optionalTimestamp('createdAt');
    }

    function validChecklistDoc() {
      return schemaV1()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'checkedIds',
          'updatedAt',
        ])
        && request.resource.data.checkedIds is list
        && optionalTimestamp('updatedAt');
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserDoc();

      match /profile/{profileId} {
        allow read, delete: if isOwner(uid) && profileId == 'current';
        allow create, update: if isOwner(uid)
          && profileId == 'current'
          && validProfileDoc();
      }

      match /insurances/{insuranceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validInsuranceDoc(insuranceId);
      }

      match /reportRuns/{reportId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validReportDoc();
      }

      match /checklists/{checklistId} {
        allow read, delete: if isOwner(uid) && checklistId == 'current';
        allow create, update: if isOwner(uid)
          && checklistId == 'current'
          && validChecklistDoc();
      }
    }
  }
}
